#!/bin/bash
# usage: cru <tool> '<json args>' [image path]
python3 - "$@" <<'PY'
import json,sys,urllib.request
name=sys.argv[1]; args=json.loads(sys.argv[2]) if len(sys.argv)>2 and sys.argv[2] else {}
if len(args)==0 and len(sys.argv)>2 and sys.argv[2].startswith('@'): pass
img=sys.argv[3] if len(sys.argv)>3 else None
req=urllib.request.Request('http://127.0.0.1:7777/call',data=json.dumps({'name':name,'args':args,'img':img}).encode())
print(urllib.request.urlopen(req,timeout=900).read().decode())
PY
